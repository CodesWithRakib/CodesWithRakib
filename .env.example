# ==============================================================================
# Environment Configuration Template for CodesWithRakib Portfolio
# ==============================================================================
# Note: Never commit real credentials to version control.
# Copy this file to .env.local to configure local overrides.

# Optional: Resend API Key for Contact Form live email delivery
# Register for a free API key at https://resend.com
RESEND_API_KEY=""

# Optional: Verified sender email (default Resend testing sender is onboarding@resend.dev)
CONTACT_FROM_EMAIL="onboarding@resend.dev"

# Recipient email address where contact submissions are forwarded
CONTACT_TO_EMAIL="codeswithrakib@gmail.com"

# Set to "true" to test server endpoint validation in production without an API key
CONTACT_SIMULATION="false"
